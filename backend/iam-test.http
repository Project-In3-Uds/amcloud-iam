###
##Demander un token de réinitialisation de mot de passe
POST http://localhost:8081/auth/forgot-password
Content-Type: application/json

{
"email": "andersonmetsanoum@gmail.com"
}

{%
// Pour le test, si le service renvoie le token dans le message de succès (ce qui n'est pas recommandé en prod)
// Adaptez cette regex si le format du message change
const responseBody = response.body;
const tokenMatch = responseBody.match(/pour testing: (.*)).$/); // Ancienne regex
if (tokenMatch && tokenMatch[1]) {
client.global.set("reset_password_token", tokenMatch[1]);
} else {
// Si le token n'est plus exposé dans la réponse, vous devrez le récupérer depuis les logs du serveur
// ou simuler sa réception pour le test de reset-password.
// Pour l'instant, nous allons le laisser vide si non trouvé.
client.global.set("reset_password_token", "TOKEN_FROM_SERVER_LOGS_OR_MOCK");
console.log("Password reset token not found in response. Please check server logs for the token.");
}
%}

###
#Réinitialiser le mot de passe avec le token
POST http://localhost:8081/auth/reset-password
Content-Type: application/json

{
"token": "378768db-d350-4a46-bf92-6a70f2ba7a8c",
"newPassword": "NewStrongPassword1!",
"confirmNewPassword": "NewStrongPassword1!"
}
